# PostgreSQL on Dokploy's private network. Do not expose port 5432 publicly.
DATABASE_URL=postgresql://macm:change-me@postgres:5432/macm
DATABASE_POOL_MAX=5
# Required at runtime for new encrypted customer-data writes. Generate with npm run data:key.
DATA_ENCRYPTION_KEY=
# Keep the previous version temporarily during a key rotation.
DATA_ENCRYPTION_KEY_PREVIOUS=
# For production PostgreSQL, append sslmode=verify-full when CA/hostname verification is configured.
DATABASE_SSL_MODE=

# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://macm.lk

# Comma-separated, normalized email addresses. This list is authoritative.
ADMIN_EMAILS=you@example.com

# Direct SMTP delivery for OTP and project-update emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=MACM Studio <no-reply@macm.lk>

# Direct lead alerts. Telegram topic/thread ID is optional.
LEAD_NOTIFICATION_EMAIL=hello@macm.lk
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MESSAGE_THREAD_ID=
# Customer Telegram linking and project-update notifications.
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=https://macm.lk/api/telegram/webhook

# Google Calendar Appointment Schedule and server-side appointment visibility.
# The booking page URL is intentionally link-accessible; the portal entry point remains protected.
GOOGLE_BOOKING_PAGE_URL=
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_CALENDAR_TIME_ZONE=Asia/Colombo

# Public Google tag ID for this site's tag configuration.
NEXT_PUBLIC_GOOGLE_TAG_ID=GT-578PGM8R

# Public GA4 web stream measurement ID.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-82X4D9K6PB

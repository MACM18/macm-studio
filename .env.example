# PostgreSQL on Dokploy's private network. Do not expose port 5432 publicly.
DATABASE_URL=postgresql://macm:change-me@postgres:5432/macm
DATABASE_POOL_MAX=5

# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://macm.lk

# Comma-separated, normalized email addresses. This list is authoritative.
ADMIN_EMAILS=you@example.com

# Direct SMTP delivery for OTP and project-update emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=MACM Studio <no-reply@macm.lk>

# n8n lead alert webhook. A failed delivery does not discard the stored lead.
LEAD_WEBHOOK_URL=

# Public Google tag ID for this site's tag configuration.
NEXT_PUBLIC_GOOGLE_TAG_ID=GT-578PGM8R

# Public GA4 web stream measurement ID.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-82X4D9K6PB
